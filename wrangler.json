{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal-document-extractor",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"routes": [
		{ "pattern": "pde.kalke.dev", "custom_domain": true }
	],
	"vars": {
		"REDIS_TLS": "true",
		"REDIS_DB": "0",
		"OIDC_AUDIENCE": "personal-document-extractor",
		"AUTH_INTROSPECT_URL": "https://auth.kalke.dev/v1/introspect",
		"CORS_ORIGINS": "https://kalke.dev,https://www.kalke.dev",
		"RATE_LIMIT_PER_MINUTE": "60",
		"LOG_LEVEL": "info",
		"LOG_FORMAT": "json",
		"GROQ_MODEL": "qwen/qwen3.6-27b",
		"GROQ_BASE_URL": "https://api.groq.com/openai/v1"
	},
	"containers": [
		{
			"class_name": "PDEContainer",
			"image": "./Dockerfile",
			"max_instances": 3,
			"instance_type": "basic"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "API",
				"class_name": "PDEContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PDEContainer"]
		}
	]
}
