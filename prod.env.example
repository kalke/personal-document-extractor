# Copy to prod.env (gitignored) and fill values.
# Prefer AWS Secrets Manager (SECRET_ID) for secrets; this file can be slim:
#   AWS_REGION / SECRET_ID / POSTGRES_PASSWORD
# Compose pins DATABASE_URL to Docker pde-db (not public). Do not open :5432.
# WARP + Zero Trust private route: DBeaver host 172.18.10.12 (extractor / extractor). SSL off.

PORT='8080'
DATABASE_URL='postgres://extractor:PASSWORD@pde-db:5432/extractor?sslmode=disable'
DB_SEARCH_PATH='pde'
POSTGRES_USER='extractor'
POSTGRES_PASSWORD=''
POSTGRES_DB='extractor'
REDIS_ADDR='YOUR.upstash.io:6379'
REDIS_PASSWORD=''
REDIS_TLS='true'
REDIS_DB='0'
OIDC_ISSUER='https://auth.kalke.dev/realms/kalke'
OIDC_AUDIENCE='personal-document-extractor'
OIDC_DISCOVERY_URL='http://auth:8081/realms/kalke'
AUTH_INTROSPECT_URL='https://auth.kalke.dev/v1/introspect'
INTROSPECT_SECRET=''
CORS_ORIGINS='https://kalke.dev,https://www.kalke.dev,http://localhost:5173'
GROQ_API_KEY=''
# Must match Auth BFF PDE_USER_FORWARD_SECRET.
M2M_USER_FORWARD_SECRET=''
LOG_LEVEL='info'
LOG_FORMAT='json'
RATE_LIMIT_PER_MINUTE='60'
AWS_REGION='us-east-1'
SECRET_ID='kalke/pde/prod'
