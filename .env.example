GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LOG_LEVEL=info
REDIS_DB=0
REDIS_CACHE_TTL=24h
REDIS_PASSWORD=
# Set true for Upstash / rediss (production).
REDIS_TLS=false
POSTGRES_USER=extractor
POSTGRES_PASSWORD=extractor
POSTGRES_DB=extractor
PORT=8080

LOG_FORMAT=text
DATABASE_URL=postgres://extractor:extractor@localhost:5432/extractor?sslmode=disable
REDIS_ADDR=localhost:6379
# Comma-separated CIDRs/IPs of reverse proxies allowed to set X-Forwarded-For / X-Real-IP.
# Empty (default): always use RemoteAddr.
TRUSTED_PROXIES=

# Browser sandbox (kalke.dev)
CORS_ORIGINS=https://kalke.dev,https://www.kalke.dev,http://localhost:5173,http://127.0.0.1:5173

# OIDC IdP (required). Sibling kalke-auth defaults:
OIDC_ISSUER=http://localhost:8443/realms/kalke
OIDC_AUDIENCE=personal-document-extractor
# Docker API → Caddy on shared network `kalke-auth` (leave empty for host `make run`):
# OIDC_DISCOVERY_URL=http://caddy:8443/realms/kalke

# Per-principal extract rate limit (fail-closed if Redis is down).
RATE_LIMIT_PER_MINUTE=60
